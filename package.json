{
  "name": "nuxt-cos-monorepo",
  "private": true,
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "description": "Load shared dependencies from Cross-Origin Storage",
  "author": {
    "name": "Daniel Roe",
    "email": "daniel@roe.dev",
    "url": "https://github.com/danielroe"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "test": "pnpm -r test:unit",
    "test:types": "pnpm -r test:types"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.17.0",
    "eslint": "10.10.0",
    "pkg-pr-new": "0.0.88",
    "typescript": "6.0.3"
  }
}
